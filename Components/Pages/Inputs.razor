@page "/inputs"
@using BlackScholesApp.ViewModels
@inject MainViewModel ViewModel
@inject TickerSearchViewModel TickerViewModel

<!-- Включаем интерактивный режим, чтобы события кликов и ввода работали мгновенно -->
@rendermode InteractiveServer

<div class="window-mock">
    <h2 class="mb-4 text-center">Опционный калькулятор Блэка-Шоулза (Веб-версия)</h2>

    <div class="row">
        <!-- ЛЕВАЯ ПАНЕЛЬ: ВВОД ДАННЫХ -->
        <div class="col-md-6 border-end border-secondary pe-4">
            <h4>Параметры ввода</h4>
            
            <!-- Поиск Тикера (WPF ComboBox AutoComplete) -->
            <div class="mb-3 position-relative">
                <label class="form-label">Тикер опциона:</label>
                <input type="text" @bind="ViewModel.Ticker" @bind:event="oninput" @onkeyup="HandleTickerSearch" />
                @if (ViewModel.HasTickerError)
                {
                    <span class="text-danger small">@ViewModel.TickerError</span>
                }
                
                <!-- Всплывающий список автодополнения -->
                @if (TickerViewModel.Suggestions != null && TickerViewModel.Suggestions.Any())
                {
                    <div class="list-group position-absolute w-100" style="z-index: 1000; max-height: 200px; overflow-y: auto;">
                        @foreach (var suggestion in TickerViewModel.Suggestions)
                        {
                            <button type="button" class="list-group-item list-group-item-action list-group-item-dark" 
                                    @onclick="() => SelectTicker(suggestion.Ticker)">
                                <strong>@suggestion.Ticker</strong> <span class="small text-muted">@suggestion.SubText</span>
                            </button>
                        }
                    </div>
                }
            </div>

            <!-- Тип опциона (WPF RadioButtons) -->
            <div class="mb-3">
                <label class="form-label d-block">Тип опциона:</label>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" id="call" name="optionType" checked="@ViewModel.IsCall" @onchange="() => SetOptionType(true)">
                    <label class="form-check-label" for="call">Call</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" id="put" name="optionType" checked="@ViewModel.IsPut" @onchange="() => SetOptionType(false)">
                    <label class="form-check-label" for="put">Put</label>
                </div>
            </div>

            <!-- Безрисковая ставка -->
            <div class="mb-3">
                <label class="form-label">Безрисковая ставка (%):</label>
                <input type="text" @bind="ViewModel.RiskFreeRateText" />
                <span class="text-muted small">Текущая ставка: @ViewModel.RiskFreeRateDisplay</span>
            </div>

            <!-- Альфа параметр -->
            <div class="mb-4">
                <label class="form-label">Параметр Альфа (α):</label>
                <input type="text" @bind="ViewModel.AlphaText" />
            </div>

            <!-- Кнопки управления (WPF Buttons) -->
            <div class="d-flex gap-2">
                <button class="btn-wpf" @onclick="ViewModel.LoadDataAsync" disabled="@ViewModel.IsBusy">
                    Загрузить данные
                </button>
                <button class="btn-wpf" @onclick="ViewModel.CalculatePriceAsync" disabled="@(!ViewModel.CanCalculate)">
                    Рассчитать
                </button>
            </div>
        </div>

        <!-- ПРАВАЯ ПАНЕЛЬ: РЕЗУЛЬТАТЫ И СТАТУСЫ -->
        <div class="col-md-6 ps-4 d-flex flex-column justify-content-between">
            <div>
                <h4>Данные из MOEX</h4>
                <table class="table table-dark table-sm table-borderless">
                    <tbody>
                        <tr><td>Базовый актив:</td><td class="text-info">@ViewModel.UnderlyingTickerDisplay</td></tr>
                        <tr><td>Цена базового актива:</td><td class="text-info">@ViewModel.UnderlyingPriceDisplay</td></tr>
                        <tr><td>Страйк:</td><td class="text-info">@ViewModel.StrikeDisplay</td></tr>
                        <tr><td>Дата экспирации:</td><td class="text-info">@ViewModel.ExpiryDisplay</td></tr>
                        <tr><td>Дней до экспирации:</td><td class="text-info">@ViewModel.TimeToExpiryDisplay</td></tr>
                        <tr><td>Волатильность:</td><td class="text-info">@ViewModel.VolatilityDisplay</td></tr>
                        <tr><td>Источник волатильности:</td><td class="text-info">@ViewModel.VolatilitySourceDisplay</td></tr>
                    </tbody>
                </table>

                @if (ViewModel.HasResults)
                {
                    <h4 class="mt-4">Результаты расчета</h4>
                    <table class="table table-dark table-sm table-borderless">
                        <tbody>
                            <tr><td>Теоретическая цена:</td><td class="text-success fs-5 fw-bold">@ViewModel.FairPriceDisplay</td></tr>
                            <tr><td>Рыночная цена:</td><td>@ViewModel.CurrentMarketPriceResult</td></tr>
                            <tr>
                                <td>Отклонение:</td>
                                <td style="color: @ViewModel.DifferenceColor; font-weight: bold;">@ViewModel.DifferenceDisplay</td>
                            </tr>
                        </tbody>
                    </table>
                }
            </div>

            <!-- Строка состояния (WPF StatusBar) -->
            <div class="mt-4 p-2 rounded" style="background-color: #333; border-left: 4px solid #007acc;">
                <span class="small">@ViewModel.StatusMessage</span>
            </div>
        </div>
    </div>
</div>

@code {
    // Делаем метод асинхронным (async Task), чтобы вызвать ваш OnQueryChangedAsync
    private async Task HandleTickerSearch(KeyboardEventArgs e)
    {
        // Передаем текущий текст тикера в ваш метод OnQueryChangedAsync
        await TickerViewModel.OnQueryChangedAsync(ViewModel.Ticker);
    }

    private void SelectTicker(string selectedTicker)
    {
        ViewModel.Ticker = selectedTicker;
        TickerViewModel.Suggestions?.Clear(); // Скрываем подсказки после выбора
    }

    private void SetOptionType(bool isCall)
    {
        ViewModel.IsCall = isCall;
    }
}


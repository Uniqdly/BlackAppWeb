@page "/screener"

<PageTitle>FBS — Скринер опционов</PageTitle>

<div class="page-wrapper">

    <!-- Шапка -->
    <header class="app-header">
        <div class="header-inner">
            <div class="logo-block">
                <span class="logo-icon">📈</span>
                <div>
                    <h1 class="app-title">Скринер опционов</h1>
                    <p class="app-subtitle">
                        Поиск недооценённых и переоценённых опционов
                    </p>
                </div>
            </div>

            <div class="header-stats">
                <div class="stat-chip">
                    <span class="stat-label">Недооценённых</span>
                    <span class="stat-value">@Undervalued.Count</span>
                </div>

                <div class="stat-chip">
                    <span class="stat-label">Переоценённых</span>
                    <span class="stat-value">@Overvalued.Count</span>
                </div>
            </div>
        </div>
    </header>

    <main class="main-grid">

        <!-- Левая колонка -->
        <div class="col-left">

            <section class="card">
                <div class="card-header">
                    <span class="card-icon">🟢</span>
                    <h2 class="card-title">Недооценённые опционы</h2>
                </div>

                <div class="card-body">

                    @foreach (var option in Undervalued)
                    {
                        <div class="result-block diff-under mb-3">

                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <strong>@option.Ticker</strong>
                                    <span class="badge @(option.OptionType == "CALL" ? "badge-call" : "badge-put") ms-2">
                                        @option.OptionType
                                    </span>
                                </div>

                                <div class="fair-price">
                                    @option.DifferencePercent.ToString("F1")%
                                </div>
                            </div>

                            <hr />

                            <div class="params-grid">

                                <div class="param-item">
                                    <span class="param-label">Рыночная цена</span>
                                    <span class="param-value mono">
                                        @option.MarketPrice.ToString("N2")
                                    </span>
                                </div>

                                <div class="param-item">
                                    <span class="param-label">Справедливая цена</span>
                                    <span class="param-value mono">
                                        @option.FairPrice.ToString("N2")
                                    </span>
                                </div>

                            </div>

                            <div class="result-meta mt-2">
                                @option.Reason
                            </div>

                            <button class="btn btn-outline btn-sm mt-3">
                                Подробнее
                            </button>

                        </div>
                    }

                </div>
            </section>

        </div>

        <!-- Правая колонка -->
        <div class="col-right">

            <section class="card">
                <div class="card-header">
                    <span class="card-icon">🔴</span>
                    <h2 class="card-title">Переоценённые опционы</h2>
                </div>

                <div class="card-body">

                    @foreach (var option in Overvalued)
                    {
                        <div class="result-block diff-over mb-3">

                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <strong>@option.Ticker</strong>
                                    <span class="badge @(option.OptionType == "CALL" ? "badge-call" : "badge-put") ms-2">
                                        @option.OptionType
                                    </span>
                                </div>

                                <div class="fair-price">
                                    +@option.DifferencePercent.ToString("F1")%
                                </div>
                            </div>

                            <hr />

                            <div class="params-grid">

                                <div class="param-item">
                                    <span class="param-label">Рыночная цена</span>
                                    <span class="param-value mono">
                                        @option.MarketPrice.ToString("N2")
                                    </span>
                                </div>

                                <div class="param-item">
                                    <span class="param-label">Справедливая цена</span>
                                    <span class="param-value mono">
                                        @option.FairPrice.ToString("N2")
                                    </span>
                                </div>

                            </div>

                            <div class="result-meta mt-2">
                                @option.Reason
                            </div>

                            <button class="btn btn-outline btn-sm mt-3">
                                Подробнее
                            </button>

                        </div>
                    }

                </div>
            </section>

        </div>

    </main>

    <footer class="app-footer">
        <div class="footer-inner">
            <span>Fractional Black–Scholes</span>
            <span>Скринер рыночных аномалий</span>
            <span>MOEX ISS API</span>
        </div>
    </footer>

</div>

@code {


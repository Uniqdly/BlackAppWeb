    {
        new()
        {
            Ticker = "RI65000BC5",
            OptionType = "CALL",
            MarketPrice = 1250,
            FairPrice = 1530,
            DifferencePercent = -18.3,
            Reason = "Цена значительно ниже расчётной стоимости."
        },
        new()
        {
            Ticker = "Si95000BC5",
            OptionType = "CALL",
            MarketPrice = 820,
            FairPrice = 1010,
            DifferencePercent = -18.8,
            Reason = "Возможная недооценка по дробной модели."
        }
    };

    private List<ScreenerOption> Overvalued = new()
    {
        new()
        {
            Ticker = "RI60000BC5",
            OptionType = "PUT",
            MarketPrice = 1900,
            FairPrice = 1400,
            DifferencePercent = 35.7,
            Reason = "Рыночная цена заметно выше модели."
        },
        new()
        {
            Ticker = "GAZP180P",
            OptionType = "PUT",
            MarketPrice = 230,
            FairPrice = 170,
            DifferencePercent = 35.2,
            Reason = "Возможная переоценка опциона."
        }
    };

    public class ScreenerOption
    {
        public string Ticker { get; set; } = "";
        public string OptionType { get; set; } = "";
        public double MarketPrice { get; set; }
        public double FairPrice { get; set; }
        public double DifferencePercent { get; set; }
        public string Reason { get; set; } = "";
    }
}